root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
# 1. Indentation: 4 spaces instead of tabs
indent_style = space
indent_size = 4
tab_width = 4

# 2. Curly Braces: Keep '{' on the same line (disable Allman newline jumps)
csharp_new_line_before_open_brace = none

# 3. License Header: Automatically injected by 'dotnet format'
file_header_template = Copyright (C) {year} Your Name\nSPDX-License-Identifier: LGPL-3.0-or-later
